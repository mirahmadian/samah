[Unit]
Description=Samah Registration System - Haj Organization
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/home/user/samah
Environment="PATH=/home/user/samah/venv/bin"
Environment="SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_KEY"
ExecStart=/home/user/samah/venv/bin/gunicorn -c gunicorn.conf.py wsgi:application
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
